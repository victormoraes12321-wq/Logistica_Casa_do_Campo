# Ambiente
FLASK_ENV=production
DEBUG=false
SECRET_KEY=troque_esta_chave

# Runtime
APP_RUNTIME=flask
APP_HOST=127.0.0.1
APP_PORT=3000
LOGISTICA_ALLOWED_HOSTS=logisticacasadocampo,localhost,127.0.0.1
LOGISTICA_LEGACY_PROXY_PORT=4000

# Banco
DATABASE_URL=sqlite:///data/logistica_casa_do_campo.sqlite3

# Compatibilidade legado
LOGISTICA_HOST=127.0.0.1
LOGISTICA_PORT=3000
LOGISTICA_DB_PATH=data/logistica_casa_do_campo.sqlite3

# Seguranca
LOGISTICA_SECURE_COOKIE=0
LOGISTICA_ALLOW_PROD_DEBUG=0
LOGISTICA_ALLOW_EPHEMERAL_SECRET=0
LOGISTICA_SESSION_MAX_AGE=28800
LOGISTICA_SESSION_CLEANUP_INTERVAL=120
DRIVER_SESSION_HOURS=24
DRIVER_LOGIN_MAX_FAILURES=5
DRIVER_LOGIN_LOCK_SECONDS=300

# Login rate-limit
LOGISTICA_LOGIN_RATE_WINDOW=600
LOGISTICA_LOGIN_MAX_FAILURES=6
LOGISTICA_LOGIN_LOCK_SECONDS=300

# Concorrencia/performance
LOGISTICA_MAX_WORKERS=40
LOGISTICA_REQUEST_TIMEOUT=30
LOGISTICA_STATS_MAINTENANCE_INTERVAL=90

# ===========================================================================
# INTEGRAÇÃO ERP (READ-ONLY) — preencha com os dados reais no .env do servidor
# ===========================================================================

# Habilitar integração (false = desabilitado, formulário funciona manual)
ERP_ENABLED=false

# Driver do banco ERP: sqlserver | mysql | postgresql
ERP_DB_DRIVER=sqlserver

# Conexão com o banco do ERP
ERP_DB_HOST=192.168.1.10
ERP_DB_PORT=1433
ERP_DB_NAME=NOME_DO_BANCO_ERP
ERP_DB_SCHEMA=dbo
ERP_DB_USER=usuario_readonly_erp
ERP_DB_PASSWORD=senha_readonly_erp
ERP_DB_TIMEOUT=5

# Intervalo do sync automático de faturamento (em minutos, 0 = desabilitado)
ERP_SYNC_INTERVAL_MIN=30

# Nomes das views do ERP (altere se o ERP usar nomes diferentes)
ERP_VIEW_PEDIDOS=VW_PEDIDOS_CAD_LM
ERP_VIEW_ITENS=VW_ITENS_PEDIDO_CAD_LM
ERP_VIEW_CLIENTES=VW_CLIENTES_CAD_LM
ERP_VIEW_VENDEDORES=VW_VENDEDOR_CAD_LM
ERP_VIEW_PRODUTOS=VW_PRODUTOS_CAD_LM
ERP_VIEW_FATURAMENTO=VW_FATURAMENTO_CAD_LM

# Mapeamento de colunas — altere se as colunas do ERP tiverem nomes diferentes
# (Os valores abaixo são os padrões assumidos; só altere se necessário)
ERP_COL_NUMERO_PEDIDO=numeropedido
ERP_COL_DATA_VENDA=datavenda
ERP_COL_VALOR_TOTAL=valortotal
ERP_COL_FORMA_PAGAMENTO=formapagamento
ERP_COL_NOME_CLIENTE=nomecliente
ERP_COL_CIDADE_CLIENTE=cidade
ERP_COL_UF_CLIENTE=uf
ERP_COL_BAIRRO_CLIENTE=bairro
ERP_COL_ENDERECO_CLIENTE=endereco
ERP_COL_TELEFONE_CLIENTE=telefone
ERP_COL_NOME_VENDEDOR=nomevendedor
ERP_COL_ITEM_CODIGO=codigoproduto
ERP_COL_ITEM_NOME=nomeproduto
ERP_COL_ITEM_QTD=quantidade
ERP_COL_ITEM_UNIDADE=unidade
ERP_COL_ITEM_PESO=pesoproduto
ERP_COL_NF_NUMERO=numeronf
ERP_COL_NF_DATA=datafaturamento
